# PostcodeProof environment. Copy to .env and replace every CHANGE_ME value.
# NEVER commit .env. NEVER reuse a secret from a previous project or environment: generate new ones.

# --- API ---
PORT=3001
NODE_ENV=development
# Use a least-privilege role (pp_app) in production. See docs/operations/database-roles in docs/architecture/database-design.md.
DATABASE_URL=postgres://CHANGE_ME_USER:CHANGE_ME_PASSWORD@127.0.0.1:5432/postcodeproof
# 32 random bytes as 64 hex characters (openssl rand -hex 32). Versioned form below takes precedence.
APP_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
# Optional versioned keyring for rotation, e.g. "1:<64 hex>,2:<64 hex>". New data uses the highest version.
APP_ENCRYPTION_KEYS=
APP_ENCRYPTION_KEY_VERSION=
# At least 32 random characters. Used to hash session tokens, API keys and IP addresses at rest.
APP_HASH_PEPPER=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
# Credential issuer key (0x + 64 hex). Development only here; use a KMS/HSM-backed signer in production.
ISSUER_PRIVATE_KEY=CHANGE_ME_0X_PRIVATE_KEY
# Extra issuer addresses still trusted after an issuer key rotation (comma separated).
TRUSTED_ISSUER_ADDRESSES=
# Browser origins allowed to call state-changing endpoints (comma separated). Required in production.
ALLOWED_ORIGINS=
# "standard" (production) or "embedded" (cross-site preview frames, development only).
SESSION_COOKIE_MODE=
# Public base URL of the web app, used when building links in emails.
APP_BASE_URL=

# --- Email ---
# "dev" writes messages to .dev-mail/outbox.jsonl (never in production). "webhook" POSTs to your email service.
MAILER=
MAIL_WEBHOOK_URL=CHANGE_ME_HTTPS_URL_OF_YOUR_EMAIL_SERVICE
# Development only: exposes one-time email links at /api/v1/dev/outbox. Leave empty everywhere else.
ENABLE_DEV_OUTBOX=

# --- Onchain anchoring (optional; nothing is deployed by this repository) ---
# Address of a CredentialRegistry you deployed yourself. Public value. Leave empty to keep anchoring disabled.
VITE_REGISTRY_ADDRESS=
# Arc Testnet 5042002, Arc Mainnet 5042.
ANCHOR_CHAIN_ID=5042002
TRUST_PROXY=false
